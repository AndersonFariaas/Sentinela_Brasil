{
  "name": "sentinela-backend",
  "version": "0.1.0",
  "description": "API do SENTINELA",
  "main": "index.js",
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "ingestao": "tsx --env-file-if-exists=../.env src/jobs/ingestao.ts",
    "metricas": "tsx tests/metricas/executar-metricas.ts",
    "limpeza": "tsx --env-file-if-exists=../.env src/jobs/limpeza.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": "true",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@supabase/supabase-js": "^2.118.0",
    "fastify": "^5.12.7",
    "resend": "6.34.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
