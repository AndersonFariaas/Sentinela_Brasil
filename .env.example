# Copie este arquivo para .env e preencha os valores. Nunca versione o .env.

# Back-end
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Origens do front-end autorizadas pelo CORS (separadas por vírgula).
CORS_ORIGIN=http://localhost:5173

# Supabase
# URL e chave pública (anon). A chave pública é segura para o servidor, mas quem decide o que
# pode ser lido ou escrito é a RLS do banco.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=

# Somente para os testes de integração de RLS (npm run test:integration, dentro de backend/).
# Dá acesso total ao banco: nunca coloque no front-end, nunca versione.
SUPABASE_SERVICE_ROLE_KEY=

# Front-end (variáveis VITE_ são públicas no navegador: nunca coloque segredos aqui)
VITE_API_URL=http://localhost:3000
