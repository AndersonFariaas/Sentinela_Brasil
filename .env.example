# Copie este arquivo para .env e preencha os valores. Nunca versione o .env.

# Back-end
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Origens do front-end autorizadas pelo CORS (separadas por vírgula).
CORS_ORIGIN=http://localhost:5173

# Supabase
# URL e chave pública (anon). A chave pública é segura para o servidor, mas quem decide o que
# pode ser lido ou escrito é a RLS do banco.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=

# Somente para os testes de integração de RLS (npm run test:integration, dentro de backend/).
# Dá acesso total ao banco: nunca coloque no front-end, nunca versione.
SUPABASE_SERVICE_ROLE_KEY=

# IA do analista (Fase 6). Sem a chave, a análise usa só o texto determinístico.
# A chave é do servidor: nunca coloque no front-end (VITE_*) nem versione.
ANTHROPIC_API_KEY=
# Modelo padrão: claude-haiku-5-5 (custo baixo). Para respostas mais elaboradas, use claude-opus-5-5.
IA_MODELO=claude-haiku-5-5
IA_TIMEOUT_MS=15000

# Alertas por e-mail (Fase 7). Sem a chave, os alertas ficam desativados e a coleta segue.
# A chave é do servidor: nunca coloque no front-end (VITE_*) nem versione.
RESEND_API_KEY=
# Remetente. Sem domínio verificado, use o padrão de testes: só envia para o e-mail da conta Resend.
ALERTA_REMETENTE=
# Base pública da API, usada no link de cancelamento do e-mail. Sem ela, o alerta não é enviado.
URL_PUBLICA_API=

# Front-end (variáveis VITE_ são públicas no navegador: nunca coloque segredos aqui)
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=
